# Local development only; replace credentials for any shared deployment.
DATABASE_URL=postgresql://serentax:local_dev_only@127.0.0.1:5432/serentax?schema=public
POSTGRES_USER=serentax
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=serentax
REDIS_URL=redis://127.0.0.1:6379

# Required for account services. Generate a random secret (32+ characters).
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=accounts@serentax.local
# Production SMTP requires TLS and authentication.
SMTP_USER=
SMTP_PASSWORD=
# Production: name of the client-IP header replaced by your trusted ingress.
# Block direct ingress to the app; never trust a header from arbitrary clients.
# AUTH_PROXY_IP_HEADER=x-real-ip

# Optional: 32+ character key for encrypting tax identifiers at rest (falls back to BETTER_AUTH_SECRET in development).
# TAX_DATA_KEY=
# Optional: private directory outside the web root for uploaded source documents.
# DOCUMENT_STORAGE_DIR=

# ---------------------------------------------------------------------------
# AI / OCR vendor secrets (template). The product owner chooses the vendor in
# Superadmin -> OCR providers and enters ONLY the variable NAME as "secret
# reference"; the value lives here on the server and is never stored in the
# database. Leave unused ones empty. See core_docs/15_AI_OCR_PROVIDERS.md.
# ---------------------------------------------------------------------------
# Claude via Anthropic API (adapter "Claude (Anthropic API)") - API key:
# OCR_ANTHROPIC_API_KEY=
# Claude via AWS Bedrock - Bedrock API key, or ACCESS_KEY_ID:SECRET_ACCESS_KEY[:SESSION_TOKEN].
# Leave empty to use the server's IAM role:
# OCR_BEDROCK_CREDENTIALS=
# AWS Textract - ACCESS_KEY_ID:SECRET_ACCESS_KEY[:SESSION_TOKEN] (empty = IAM role):
# OCR_TEXTRACT_CREDENTIALS=
# Google Document AI - service-account JSON (raw JSON on one line, or base64):
# OCR_GOOGLE_DOCAI_SERVICE_ACCOUNT=
# OpenAI-compatible chat-completions endpoint - Bearer API key:
# OCR_OPENAI_COMPATIBLE_API_KEY=
# Generic HTTP OCR service (SerenTax JSON contract) - Bearer token:
# OCR_GENERIC_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# Data & privacy policy shown to customers (Settings -> Data & privacy).
# State only what is true for this deployment; empty values show
# "not yet set by the service provider".
# ---------------------------------------------------------------------------
# DATA_STORAGE_LOCATION=AWS ap-southeast-3 (Jakarta)
# DATA_RETENTION_DAYS_AFTER_TERMINATION=90
# DATA_EXPORT_DAYS_AFTER_TERMINATION=30
# JSON list of platform sub-processors (hosting, email, ...). The workspace's
# chosen OCR vendor is added automatically.
# PLATFORM_SUBPROCESSORS=[{"name":"Amazon Web Services","purpose":"Hosting & storage","location":"Indonesia"}]

# ---------------------------------------------------------------------------
# Subscription termination & automatic deletion (Settings -> Data & privacy).
# Run the daily job with `npm run data:lifecycle`, or call
# POST /api/internal/lifecycle with header x-job-token from a scheduler.
# ---------------------------------------------------------------------------
# DATA_TERMINATION_NOTICE_DAYS=30
# LIFECYCLE_JOB_TOKEN=   # 32+ random characters; empty disables the HTTP job endpoint

# ---------------------------------------------------------------------------
# Customer invoices (per-invoice offers). Issuing is blocked until the issuer
# name, address and bank account are set.
# ---------------------------------------------------------------------------
# BILLING_SELLER_NAME=
# BILLING_SELLER_NPWP=
# BILLING_SELLER_ADDRESS=
# BILLING_SELLER_EMAIL=
# BILLING_BANK_NAME=
# BILLING_BANK_ACCOUNT_NO=
# BILLING_BANK_ACCOUNT_NAME=
# BILLING_INVOICE_PREFIX=INV/SRX
# Suspend creating new records when an issued invoice is N days past due (empty = never):
# BILLING_SUSPEND_AFTER_DAYS_OVERDUE=
