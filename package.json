{
  "name": "serentax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @serentax/web",
    "build": "npm run db:generate && npm run build -w @serentax/web",
    "start": "npm run start -w @serentax/web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && npm run typecheck -w @serentax/web && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx scripts/check-database.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate deploy",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "mailparser": "3.14.3",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "smtp-server": "3.21.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
